LDAP_ENABLED=true
LDAP_HOST="ldap://dc-1.stjohnshospital.ie"
LDAP_DOMAIN=stjohnshospital
LDAP_PORT=389
LDAP_START_TLS=false
LDAP_TLS_CA_FILE=""
LDAP_BASE_DN="dc=stjohnshospital,dc=ie"
LDAP_BIND_FORMAT='stjohnshospital\{username}'
LDAP_USER_FILTER="(sAMAccountName={username})"
LDAP_EMAIL_DOMAIN=stjohnshospital.ie
LDAP_SYNC_BIND_USERNAME=generic.services
LDAP_SYNC_BIND_PASSWORD=""
LDAP_SYNC_BIND_FORMAT='stjohnshospital\{username}'
LDAP_SYNC_USER_FILTER="(&(objectCategory=person)(objectClass=user)(sAMAccountName=*))"
LDAP_SYNC_PAGE_SIZE=500
LDAP_SYNC_TIMEOUT=30
