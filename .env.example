APP_NAME="IS Tools"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://apps:3071
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IE
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Use the SAME is_tools database. No database container is created in production.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=is_tools
DB_USERNAME=is_tools
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci
# DATABASE_HOST_1, DATABASE_NAME_1, DATABASE_USER_1, DATABASE_PASSWORD_1 remain aliases.

SESSION_DRIVER=file
SESSION_COOKIE=sjl_is_tools_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150
FILESYSTEM_DISK=local

COMPANY_NAME="St. John's Hospital"
SUPPORT_EMAIL=
SUPPORT_EXTENSION=246
ILAB_EMAIL=
ILAB_EMAIL_CC=
ILAB_EMAIL_BCC=
IGO_EMAIL=

# Same LDAP aliases and bind convention as sjl-document-compliance.
LDAP_ENABLED=true
LDAP_HOST=ldap://dc-2.stjohnshospital.ie
LDAP_PORT=389
LDAP_START_TLS=true
LDAP_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
LDAP_DOMAIN=stjohnshospital
LDAP_BASE_DN="dc=stjohnshospital,dc=ie"
LDAP_BIND_FORMAT="stjohnshospital\\{username}"
LDAP_USER_FILTER="(sAMAccountName={username})"
LDAP_EMAIL_DOMAIN=stjohnshospital.ie
LDAP_SYNC_BIND_USERNAME=
LDAP_SYNC_BIND_PASSWORD=
LDAP_SYNC_BIND_FORMAT="stjohnshospital\\{username}"
LDAP_SYNC_USER_FILTER="(&(objectCategory=person)(objectClass=user)(sAMAccountName=*))"
LDAP_SYNC_PAGE_SIZE=500
LDAP_SYNC_TIMEOUT=15

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=spamtitan.stjohnshospital.ie
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=tracking.mail@stjohnshospital.ie
MAIL_FROM_NAME="St. John's Hospital IS Tools"

GOTENBERG_URL=http://gotenberg:3000
# Copy legacy documents/ here, preserving signatures/<form>/<sigSlug>.png and pdf/.
# DOCUMENTS_PATH=/var/www/html/documents
# Optional read-only host mount for the F: drive folders; otherwise departments are used.
DEPARTMENT_FOLDERS_PATH=
DOCKER_HTTPS_PORT=3071
VITE_APP_NAME="${APP_NAME}"
